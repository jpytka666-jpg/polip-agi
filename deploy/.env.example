# --- OBOWIAZKOWE ---------------------------------------------------------------

# Port hosta przydzielony centralnie z puli 18080-18999.
# Nadaj go poleceniem: ./deploy/port-manager/port-manager.sh allocate darkstar
DARKSTAR_HOST_PORT=18080

# Token bramki Bearer. Bez niego kazda sciezka /v1/* odpowiada 401 - fail-closed.
# TO JEST TYLKO WZORZEC. Wygeneruj wlasna wartosc i NIGDY jej nie commituj:
#   openssl rand -hex 32
DARKSTAR_API_TOKEN=REPLACE_ME_WITH_A_GENERATED_SECRET

# --- OPCJONALNE (wartosci domyslne w docker-compose.yml) ------------------------

# Adres nasluchu serwera. Domyslnie brama prywatnej sieci DARKSTAR-WiFi, zeby landing
# /world/ byl osiagalny dla urzadzen z tej sieci.
# NIGDY 0.0.0.0 ani ::  - to wystawiloby usluge takze na wlp2s0, czyli do sieci Vodafone.
# UWAGA: ten adres musi ISTNIEC na hoscie zanim wstanie kontener. Jesli interfejs bramy
# jest opuszczony, bind konczy sie bledem i restart:on-failure:5 poddaje sie po 5 probach.
DARKSTAR_BIND_ADDRESS=192.168.2.1

# Dwie nogi skladu kontekstu (Chroma). Osobne procesy, osobne katalogi danych.
DARKSTAR_CONTEXT_LOCAL=http://127.0.0.1:8000
DARKSTAR_CONTEXT_REMOTE=http://127.0.0.1:8001

# Headscale slucha na bramie prywatnej, wiec petla zwrotna mu nie odpowiada.
DARKSTAR_HEADSCALE_URL=http://192.168.2.1:8080

# Klucz API Headscale. Pusty = Darkstar czyta tylko /health, listy wezlow nie tyka.
# DARKSTAR_HEADSCALE_APIKEY=
