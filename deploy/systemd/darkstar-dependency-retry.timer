# REASON FOR CREATION: Schedule bounded Darkstar dependency recovery checks every fifteen minutes.
# MECHANICS: systemd launches exactly one oneshot recovery service per timer firing; the service never contains a sleep loop.
# SYSTEM PART: Darkstar runtime supervision
# ARCHITECTURE FUNCTION: Periodic host-level reconciliation cadence for runtime connectivity.
# DEPENDENCIES/LINKS: darkstar-dependency-retry.service, systemd timer scheduler.
# TECH STACK: systemd timer; selected because systemd provides scheduling without a resident loop.
# LOCAL WORKSPACE: /home/owner/polip-agi
# GIT COMMIT: PENDING
# GITHUB METADATA: jpytka666-jpg/polip-agi / feat/darkstar-module-control
# ==========================================

[Unit]
Description=Run Darkstar dependency recovery every 15 minutes

[Timer]
OnBootSec=15min
OnUnitActiveSec=15min
Persistent=true
Unit=darkstar-dependency-retry.service

[Install]
WantedBy=timers.target
