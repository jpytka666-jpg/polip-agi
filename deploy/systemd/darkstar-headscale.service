[Unit]
Description=Darkstar Headscale Mesh Control Server
Documentation=https://github.com/juanfont/headscale
After=docker.service darkstar.service darkstar-firewall.service
Requires=docker.service darkstar.service
PartOf=darkstar.target

[Service]
Type=simple
WorkingDirectory=/home/owner/polip-agi/deploy/headscale

# User/group — root dla dostępu do sieci i zarzadzania kontenerami
User=root
Group=root

# Pre-start: upewnij się że sieć darkstar istnieje
ExecStartPre=-/usr/bin/docker network create --driver bridge darkstar

# Start: uruchom compose
ExecStart=/usr/bin/docker compose up --no-build

# Stop: zatrzymaj compose
ExecStop=/usr/bin/docker compose down

# Restart policy
Restart=always
RestartSec=30
StartLimitInterval=300
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=darkstar-headscale

# Security — read-only root filesystem gdzie możliwe
# (Docker write to /var/lib/docker, więc nie możemy całej FS)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
