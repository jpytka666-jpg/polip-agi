set -eu

SCRIPT_NAME=darkstar-gateway-stop
ENV_FILE=${DARKSTAR_ENV_FILE:-/etc/darkstar/gateway.env}

# Bezpiecznik: domyslnie nic nie mutuje.
DARKSTAR_DRY_RUN=${DARKSTAR_DRY_RUN:-1}

fail() {
    printf '%s: %s\n' "$SCRIPT_NAME" "$1" >&2
    exit 1
}

note() {
    printf '%s: %s\n' "$SCRIPT_NAME" "$1" >&2
}

run_mutation() {
    if [ "$DARKSTAR_DRY_RUN" != 0 ]; then
        printf 'DRY_RUN would_run:'
        for arg in "$@"; do
            printf ' %s' "$arg"
        done
        printf '\n'
        return 0
    fi
    "$@"
}

[ -r "$ENV_FILE" ] || fail "missing readable environment contract: $ENV_FILE"
# shellcheck disable=SC1090
. "$ENV_FILE"

: "${DARKSTAR_CONNECTION_NAME:?missing DARKSTAR_CONNECTION_NAME}"
: "${DARKSTAR_UPSTREAM_IFACE:?missing DARKSTAR_UPSTREAM_IFACE}"

command -v nmcli >/dev/null 2>&1 || fail 'required command not found: nmcli'

# Zabezpieczenie przed odcieciem wlasnej drogi zarzadzania.
if [ "$DARKSTAR_CONNECTION_NAME" = "$DARKSTAR_UPSTREAM_IFACE" ]; then
    fail 'refusing to touch the upstream management connection'
fi

if [ "$DARKSTAR_DRY_RUN" != 0 ]; then
    note 'dry run - no connection will be deactivated'
else
    [ "$(id -u)" -eq 0 ] || fail 'must run as root when DARKSTAR_DRY_RUN=0'
fi

if nmcli -t -f NAME connection show --active 2>/dev/null |
    grep -Fxq "$DARKSTAR_CONNECTION_NAME"; then
    run_mutation nmcli connection down "$DARKSTAR_CONNECTION_NAME"
    note "deactivated $DARKSTAR_CONNECTION_NAME; profile kept for recovery"
else
    note "$DARKSTAR_CONNECTION_NAME is not active; nothing to deactivate"
fi

note 'upstream and firewall left untouched'
