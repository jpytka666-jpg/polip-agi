# Copy to a local protected path and replace every placeholder.
# NEVER commit the real private key.

[Interface]
PrivateKey = <PROTECTED_HOST_PRIVATE_KEY_LOCAL_ONLY>
Address = 10.77.0.2/32
DNS = 10.77.0.1

[Peer]
PublicKey = <DARKSTAR_PUBLIC_KEY>
Endpoint = <DARKSTAR_REACHABLE_IP_OR_NAME>:51820
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
