set -eu

DIR="$(cd "$(dirname "$0")" && pwd)"
FAILED=0

emit() {
    printf '%s: %s\n' "$1" "$2"
}

note_fail() {
    emit "FAIL" "$1"
    FAILED=1
}

if ! command -v docker >/dev/null 2>&1; then
    emit "WARN" "brak polecenia docker - pomijam Step 14.11"
    exit 0
fi

BEFORE=$(ls -1 "$DIR" | sort)

# `cd` najpierw i wolaj docker z golym plikiem wzglednym - przekazanie dockerowi
# absolutnej sciezki w stylu Git Bash (/d/...) na Windows konczy sie zlym tlumaczeniem
# na sciezke Windows i "system cannot find the path specified", nawet gdy plik istnieje.
OUTPUT=$(cd "$DIR" && docker compose -f compose.yml config 2>&1)
STATUS=$?

# `config` rozwiazuje YAML; nie dotyka dysku poza plikami wejsciowymi, wiec oczekiwany
# kod wyjscia to 0 - to jest zmierzone zachowanie, nie zalozenie.
if [ "$STATUS" -eq 0 ]; then
    emit "PASS" "docker compose config rozwiazuje sie (kod 0) - tak jak zmierzono"
else
    note_fail "docker compose config zakonczyl sie kodem $STATUS - zachowanie narzedzia sie zmienilo, zbadaj to"
fi

if printf '%s' "$OUTPUT" | grep -q '0\.0\.0\.0'; then
    note_fail "rozwiazany config zawiera 0.0.0.0"
else
    emit "PASS" "rozwiazany config nie zawiera 0.0.0.0"
fi

if printf '%s' "$OUTPUT" | grep -q '127\.0\.0\.1'; then
    emit "PASS" "rozwiazany config wiaze nasluch z petla zwrotna"
else
    note_fail "rozwiazany config nie wskazuje 127.0.0.1 - sprawdz HEADPLANE_SERVER__HOST"
fi

for secret in headplane_cookie_secret headplane_headscale_api_key; do
    if printf '%s' "$OUTPUT" | grep -q "$secret"; then
        emit "PASS" "sekret $secret jest odwolaniem do pliku, obecny w rozwiazanym config"
    else
        note_fail "sekret $secret zniknal z rozwiazanego config"
    fi
done

if printf '%s' "$OUTPUT" | grep -qE '/etc/darkstar/headplane/(cookie_secret|headscale_api_key)'; then
    emit "PASS" "sekrety wskazuja na sciezki hosta pod /etc/darkstar/headplane, nie na wartosci"
else
    note_fail "brak oczekiwanych sciezek sekretow w rozwiazanym config"
fi

AFTER=$(ls -1 "$DIR" | sort)
if [ "$BEFORE" = "$AFTER" ]; then
    emit "PASS" "uruchomienie tego skryptu nie zostawilo zadnego nowego pliku w $DIR"
else
    note_fail "znaleziono nowy plik w $DIR po uruchomieniu - docker compose config nie powinien niczego tworzyc"
fi

printf '\n%s\n' "darkstar-headplane: Step 14.11 zakonczony (wylacznie config, zero up, zero CBMS)"
[ "$FAILED" -eq 0 ] || exit 1
exit 0
