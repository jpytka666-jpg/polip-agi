[Unit]
Description=Darkstar Recall - long-term memory store (Qdrant)
Documentation=https://github.com/qdrant/qdrant
After=docker.service network-online.target
Requires=docker.service
PartOf=darkstar.target

[Service]
Type=simple
WorkingDirectory=/home/owner/polip-agi/deploy/recall

# root, bo zarzadza kontenerami. Sam Qdrant biegnie w kontenerze z odebranymi zdolnosciami.
User=root
Group=root

# Katalogi danych i migawek. Bez tego docker zalozylby je sam jako root z prawami, ktore
# uniemozliwilyby operatorowi wyniesienie kopii zapasowej bez sudo.
ExecStartPre=/usr/bin/install -d -m 0750 -o root -g root /var/lib/darkstar/recall
ExecStartPre=/usr/bin/install -d -m 0750 -o root -g root /var/lib/darkstar/recall-snapshots

ExecStart=/usr/bin/docker compose --env-file /home/owner/polip-agi/deploy/.env -f compose.yml up --no-build
ExecStop=/usr/bin/docker compose --env-file /home/owner/polip-agi/deploy/.env -f compose.yml down

Restart=always
RestartSec=30
StartLimitInterval=300
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=darkstar-recall

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
