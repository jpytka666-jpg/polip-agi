# Install as /etc/wireguard/darkstar-wg.conf only after replacing placeholders.
# NEVER commit the real private key.

[Interface]
Address = 10.77.0.1/24
ListenPort = 51820
PrivateKey = <DARKSTAR_PRIVATE_KEY_LOCAL_ONLY>

[Peer]
# Windows now / iOnis OS later
PublicKey = <PROTECTED_HOST_PUBLIC_KEY>
AllowedIPs = 10.77.0.2/32
