# REASON FOR CREATION: Atomowe, idempotentne ładowanie tabeli host guard Darkstar.
# ==========================================

set -eu

RULESET=/etc/darkstar/host-guard.nft
TABLE_FAMILY=inet
TABLE_NAME=darkstar_host_guard
TMPDIR=${TMPDIR:-/tmp}
CANDIDATE=$(mktemp "$TMPDIR/darkstar-host-guard.XXXXXX")

cleanup() {
    rm -f "$CANDIDATE"
}

log_result() {
    message=$1
    printf '%s\n' "$message" >&2
    if command -v logger >/dev/null 2>&1; then
        logger -t darkstar-firewall -- "$message" || true
    fi
}

trap cleanup EXIT HUP INT TERM

if [ "$(id -u)" -ne 0 ]; then
    log_result "darkstar-firewall: must run as root"
    exit 1
fi

if [ ! -r "$RULESET" ]; then
    log_result "darkstar-firewall: missing readable ruleset: $RULESET"
    exit 1
fi

if ! command -v nft >/dev/null 2>&1; then
    log_result "darkstar-firewall: nft command not found"
    exit 1
fi

if nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1; then
    printf 'delete table %s %s\n' "$TABLE_FAMILY" "$TABLE_NAME" > "$CANDIDATE"
fi
cat "$RULESET" >> "$CANDIDATE"

if ! nft -c -f "$CANDIDATE"; then
    log_result "darkstar-firewall: ruleset validation failed"
    exit 1
fi

if ! nft -f "$CANDIDATE"; then
    log_result "darkstar-firewall: ruleset load failed"
    exit 1
fi

log_result "darkstar-firewall: loaded inet darkstar_host_guard"
