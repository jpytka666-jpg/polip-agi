# darkstar-header-v1
# po co: host-guard.nft
# nie wolno: hotspot, ruszac wlp2s0, wracac do 10.44, gasic DARKSTAR-WiFi, haslo w gicie
# autor: Marcin
# powstal: 2026-09-02
# THIS IS VERY IMPORTANT!!!
# ==========================================
# AUTHOR: M. SZUL
# AI MODEL: GPT-5 Codex
# TIMESTAMP: 2026-09-01 08:10:27
# REASON FOR CREATION: Wersjonowany host guard nftables dla bramy Darkstar.
# ==========================================

table inet darkstar_host_guard {
    set loopback_ifaces {
        type ifname
        elements = { "lo" }
    }

    set management_ifaces {
        type ifname
        elements = { "tailscale0" }
    }

    set upstream_ifaces {
        type ifname
        elements = { "wlp2s0" }
    }

    set downstream_ifaces {
        type ifname
        elements = { "enp1s0" }
    }

    set darkstar_downstream_ipv4 {
        type ipv4_addr
        flags interval
        elements = { 192.168.2.0/24 }
    }

    chain input {
        type filter hook input priority filter; policy drop;

        iifname @loopback_ifaces accept comment "loopback"
        ct state established,related accept comment "established and related"
        ct state invalid drop comment "invalid connection state"

        ip protocol icmp accept comment "ICMPv4"
        meta l4proto ipv6-icmp accept comment "ICMPv6"

        iifname @management_ifaces accept comment "temporary Tailscale management"
        iifname @upstream_ifaces udp dport 41641 accept comment "temporary WireGuard transport"

        iifname @upstream_ifaces udp sport 67 udp dport 68 accept comment "IPv4 DHCP client"
        iifname @upstream_ifaces udp sport 547 udp dport 546 accept comment "IPv6 DHCP client"

        iifname @downstream_ifaces ip saddr @darkstar_downstream_ipv4 tcp dport 22 accept comment "downstream SSH management after Task 5"

        # NIEZASTOSOWANA. Regula lezy w pliku i czeka na swiadome przeladowanie zapory
        # przez operatora - w tej sesji nie wykonano ani `nft -f`, ani restartu
        # darkstar-firewall.service. Dopoki tego nie ma, port 8080 jest z sieci prywatnej
        # nieosiagalny: zmierzone z Windows 192.168.2.50 - TcpTestSucceeded False na 8080
        # przy jednoczesnym True na porcie 22.
        #
        # Zakres jest ten sam co u SSH powyzej: wylacznie interfejs downstream i wylacznie
        # zrodla z @darkstar_downstream_ipv4, czyli 192.168.2.0/24. Z sieci nadrzednej
        # Vodafone (@upstream_ifaces) nadal nie przechodzi nic poza transportem WireGuard
        # i klientem DHCP - ta regula tego nie zmienia.
        iifname @downstream_ifaces ip saddr @darkstar_downstream_ipv4 tcp dport 8080 accept comment "downstream Headscale control server, Task 13"

        # NIEZASTOSOWANA - tak samo jak regula 8080 powyzej w chwili jej dopisania.
        # Transport WireGuard DRUGIEGO demona tailscaled, tego ktory gada z wlasnym
        # Headscale. Port 41641 nalezy do demona do SaaS i zostaje nietkniety; nowy
        # demon dostal 41642 wlasnie po to, zeby te dwa ruchy nie mialy jak sie zejsc.
        #
        # Bez tej reguly wezly prywatnego mesh nie polacza sie bezposrednio i spadna na
        # publiczny przekaznik DERP - czyli dzialalyby tylko przy internecie, gorzej niz
        # obecny SaaS. Z nia lacza sie po kablu, bez wychodzenia na zewnatrz.
        #
        # Zakres jak u sasiadow: wylacznie interfejs downstream i wylacznie zrodla
        # z @darkstar_downstream_ipv4, czyli 192.168.2.0/24. Sieci nadrzednej Vodafone
        # ta regula nie dotyczy.
        iifname @downstream_ifaces ip saddr @darkstar_downstream_ipv4 udp dport 41642 accept comment "downstream Headscale WireGuard transport"
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state established,related accept comment "established and related"
        ct state invalid drop comment "invalid connection state"
        iifname @downstream_ifaces oifname @upstream_ifaces ip saddr @darkstar_downstream_ipv4 accept comment "Darkstar downstream IPv4 to upstream"
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        oifname @upstream_ifaces ip saddr @darkstar_downstream_ipv4 masquerade comment "Darkstar downstream IPv4 NAT"
    }
}
