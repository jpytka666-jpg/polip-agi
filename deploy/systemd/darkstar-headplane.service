[Unit]
Description=Darkstar Headplane Admin Panel
Documentation=https://github.com/tale/headplane
After=docker.service darkstar.service darkstar-firewall.service darkstar-headscale.service
Requires=docker.service darkstar.service
PartOf=darkstar.target

[Service]
Type=simple
WorkingDirectory=/home/owner/polip-agi/deploy/headplane

# User/group - root dla dostepu do sieci i zarzadzania kontenerami, tak samo jak Headscale.
User=root
Group=root

# Start: uruchom compose. Brak ExecStartPre z "docker network create" - compose.yml uzywa
# network_mode: host, wiec nie istnieje zadna wlasna siec dockerowa do zalozenia.
ExecStart=/usr/bin/docker compose up --no-build

# Stop: zatrzymaj compose
ExecStop=/usr/bin/docker compose down

# Restart policy - identyczna jak Headscale
Restart=always
RestartSec=30
StartLimitInterval=300
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=darkstar-headplane

# Security - read-only root filesystem gdzie mozliwe
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
