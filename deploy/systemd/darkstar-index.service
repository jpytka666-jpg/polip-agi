[Unit]
Description=Darkstar file index rebuild (plocate updatedb)
Documentation=man:updatedb(8)
# Duzy dysk ma byc w indeksie - jesli jeszcze nie wstal, nie ma sensu budowac indeksu bez niego.
After=mnt-aionslab.mount
Wants=mnt-aionslab.mount

[Service]
Type=oneshot
ExecStart=/usr/bin/updatedb

# Indeksowanie ustepuje wszystkiemu innemu. To brama sieciowa - ruch jest wazniejszy niz indeks.
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle

# Przebudowa nie moze wisiec w nieskonczonosc, gdyby dysk sie zawiesil.
TimeoutStartSec=30min

StandardOutput=journal
StandardError=journal
SyslogIdentifier=darkstar-index
