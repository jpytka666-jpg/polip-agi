[Unit]
Description=Darkstar file index refresh (plocate), hourly
Documentation=man:plocate(1) man:updatedb(8)

[Timer]
# Co godzine od uruchomienia maszyny, potem co godzine od poprzedniego przebiegu.
OnBootSec=10min
OnUnitActiveSec=1h
# Rozrzut, zeby odswiezanie nie trafialo zawsze w te sama sekunde razem z innymi zadaniami.
RandomizedDelaySec=5min
# Nadrobienie po wybudzeniu: jesli maszyna spala, indeks ma sie odswiezyc zaraz po starcie.
Persistent=true
Unit=darkstar-index.service

[Install]
WantedBy=timers.target
