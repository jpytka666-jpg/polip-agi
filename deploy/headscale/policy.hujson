{
  "groups": {
    "group:operators": ["user:operator@darkstar.local"],
    "group:test": ["user:testclient@darkstar.local"],
  },

  "hosts": {
    "darkstar_ssh": "192.168.2.1:22",
    "darkstar_web": "192.168.2.1:8443",
  },

  "acls": [
    // Operator: dostęp do SSH i Control Room
    {
      "action": "accept",
      "src": ["group:operators"],
      "dst": ["darkstar_ssh:22", "darkstar_web:443"],
    },

    // Test clients: bezpośrednia komunikacja między sobą (jeśli będzie kilka)
    {
      "action": "accept",
      "src": ["group:test"],
      "dst": ["group:test:*"],
    },

    // Test clients: dostęp do Darkstar SSH (dla testów)
    {
      "action": "accept",
      "src": ["group:test"],
      "dst": ["darkstar_ssh:22"],
    },

    // Default deny
    {
      "action": "deny",
      "src": ["*"],
      "dst": ["*"],
    },
  ],

  "tagOwners": {
    // Tag dla testów — operator może przypisywać
    "tag:test": ["user:operator@darkstar.local"],
  },
}
