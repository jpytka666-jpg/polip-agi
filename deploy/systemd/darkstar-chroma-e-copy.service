# darkstar-header-v1
# po co: darkstar-chroma-e-copy.service
# nie wolno: ruszac Chromy na 8000, wiazac na 0.0.0.0, pisac do kopii z dysku E
# Autor: Marcin Szul
# Model: Claude
# Czas: 2026-09-03T04:05:00+01:00
# Po co: Druga Chroma na 127.0.0.1:8001, serwujaca kopie skladu z dysku E, zeby druga noga
#        pamieci byla osobnym procesem nad osobnymi danymi, a nie ta sama baza co pierwsza.
#
# THIS IS VERY IMPORTANT!!!
# ==========================================
# MECHANICS: NIE powstaje tu nowy sposob uruchamiania Chromy. Jednostka wola istniejacy
# skrypt deploy/context/darkstar-chroma-run, ktory juz jest w pelni sterowany srodowiskiem
# (VENV, DATA_DIR, LOG_DIR, HOST, PORT). Rozni sie wylacznie dwiema wartosciami: portem
# 8001 zamiast 8000 i katalogiem danych wskazujacym na kopie z E. Zadnego obrazu Dockera
# ani pliku compose nie trzeba - biezaca Chroma na 8000 tez jest procesem natywnym.
# SYSTEM PART: deploy/systemd - druga noga pamieci.
# ARCHITECTURE FUNCTION: Drugie, niezalezne zrodlo odpowiedzi. Pierwsza noga zostaje
# nietknieta na 8000; ta jednostka nie ma zadnej sciezki, ktora moglaby ja zatrzymac.
# DEPENDENCIES/LINKS: deploy/context/darkstar-chroma-run, kopia z
# deploy/context/push-chroma-to-cbms.ps1.
# TECH STACK: systemd unit - zgodnie z reszta deploy/systemd.
# GIT COMMIT: PENDING
# GITHUB METADATA: jpytka666-jpg/polip-agi, branch docs/darkstar-headscale-hotspot-plan
#
# Jednostke zainstalowal i uruchamia OPERATOR. Ta sesja nie wykonuje ani `daemon-reload`,
# ani `start` - po tej poprawce restart jednostki nalezy do operatora.
#
# HISTORIA POPRAWKI: pierwsza wersja uzywala specyfikatora %h i wpadla w petle restartow,
# bo w jednostce systemowej %h to /root, a nie katalog domowy uzytkownika z `User=`.
# Sciezki sa teraz jawne. Ochrona zapisu zdjeta z katalogu danych - powody przy
# ReadWritePaths nizej.
# ==========================================

[Unit]
Description=Darkstar second Chroma - E copy leg on 8001
# Celowo BEZ Requires na pierwszej Chromie: nogi maja byc niezalezne. Awaria jednej nie
# ma prawa zatrzymac drugiej - to jest caly sens dwoch nog.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=owner
Group=owner

# Wylacznie petla zwrotna. 0.0.0.0 wystawiloby pamiec na wlp2s0, czyli do sieci nadrzednej.
Environment=DARKSTAR_CHROMA_HOST=127.0.0.1
Environment=DARKSTAR_CHROMA_PORT=8001

# SCIEZKI JAWNE, BEZ %h. Poprzednia wersja uzywala %h i wpadala w petle restartow, bo
# w jednostce SYSTEMOWEJ %h rozwija sie do /root - niezaleznie od `User=owner` powyzej.
# Specyfikator jest rozwijany zanim uzytkownik zostanie podstawiony, wiec usluga szukala
# kopii pod /root/chroma-e-copy, ktorego nie ma i miec nie moze.
Environment=DARKSTAR_CHROMA_DIR=/home/owner/chroma-e-copy/current
Environment=DARKSTAR_CHROMA_LOG_DIR=/home/owner/darkstar/logs

# Kopia z dysku E jest tu ZAPISYWALNA i to jest zmiana wzgledem pierwszej wersji.
# Powod: sklad Chromy to baza SQLite, ktora przy samym odczycie zaklada obok siebie
# dziennik. Ochrona `ReadOnlyPaths` chronila tu wlasciwa rzecz w niewlasciwym miejscu -
# dysk E jest bezpieczny dlatego, ze to jest KOPIA na innej maszynie, a nie dlatego, ze
# jadro zabrania zapisu. Katalog mozna w kazdej chwili odtworzyc skryptem push.
ReadWritePaths=/home/owner/chroma-e-copy /home/owner/darkstar/logs

ExecStart=/home/owner/polip-agi/deploy/context/darkstar-chroma-run

Restart=on-failure
RestartSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=darkstar-chroma-e-copy

[Install]
WantedBy=multi-user.target
