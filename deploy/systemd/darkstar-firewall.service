[Unit]
Description=Darkstar host firewall guard
Documentation=file:///etc/darkstar/host-guard.nft
After=local-fs.target
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/darkstar-firewall-apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
