set -eu

VENV=${DARKSTAR_CHROMA_VENV:-/home/owner/darkstar/venv}
DATA_DIR=${DARKSTAR_CHROMA_DIR:-/var/lib/darkstar/chroma}
LOG_DIR=${DARKSTAR_CHROMA_LOG_DIR:-/home/owner/darkstar/logs}
HOST=${DARKSTAR_CHROMA_HOST:-127.0.0.1}
PORT=${DARKSTAR_CHROMA_PORT:-8000}

fail() {
    printf 'darkstar-chroma-run: %s\n' "$1" >&2
    exit 1
}

# Bezpiecznik wiazania. 0.0.0.0 wystawiloby pamiec AIONS takze na uplink Vodafone.
case $HOST in
    127.0.0.1 | 192.168.2.1) : ;;
    *) fail "niedozwolony adres nasluchu: $HOST (dozwolone: 127.0.0.1, 192.168.2.1)" ;;
esac

[ -x "$VENV/bin/chroma" ] || fail "brak chroma w $VENV/bin"
[ -d "$DATA_DIR" ] || fail "brak katalogu danych: $DATA_DIR"

mkdir -p "$LOG_DIR"

if command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q ":$PORT "; then
    fail "port $PORT jest juz zajety - nie uruchamiam drugiej instancji na tych samych danych"
fi

printf 'darkstar-chroma-run: start na %s:%s, dane %s\n' "$HOST" "$PORT" "$DATA_DIR" >&2

# chromadb 1.5.9 nie przyjmuje juz --log-path; dziennik zbieramy przekierowaniem
# po stronie wolajacego (nohup ... > logs/run.out).
exec "$VENV/bin/chroma" run \
    --path "$DATA_DIR" \
    --host "$HOST" \
    --port "$PORT"
