# Noga PIERWSZA - zywa Chroma na CBMS. Zostaje bez zmian, odpowiada dzis 200.
DARKSTAR_CONTEXT_LOCAL=http://127.0.0.1:8000

# Noga DRUGA - Chroma nad kopia skladu z dysku E, port 8001.
#
# Dopoki jednostka darkstar-chroma-e-copy.service nie zostanie uruchomiona, pod tym
# adresem nie odpowiada NIC, a health raportuje remote_e_ok=false. Tak ma byc: flaga
# zapala sie wylacznie po odpowiedzi heartbeat z tego portu, a nie po samym wpisaniu
# adresu do konfiguracji.
#
# Czego tu NIE wpisywac:
#   100.71.8.70:8000 - to wlasny adres CBMS w sieci Tailscale. Chroma slucha wylacznie
#                      na petli zwrotnej, wiec pod tym adresem nie odpowiadalo nic i
#                      nigdy; a gdyby odpowiadalo, byl by to TEN SAM proces co noga
#                      pierwsza. Dwie nogi celujace w jeden proces nie sa dwiema nogami.
#   192.168.2.50:8000 - Chroma na Windows. Osiagalna dopiero po zmianie profilu sieciowego
#                      karty z Public na Private i wlaczeniu regul zapory Windows.
#                      Zmierzone: dzis ping, 445 i 8000 milcza.
DARKSTAR_CONTEXT_REMOTE=http://127.0.0.1:8001
