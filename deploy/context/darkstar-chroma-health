set -eu

DATA_DIR=${DARKSTAR_CHROMA_DIR:-/var/lib/darkstar/chroma}
# Dozwolone adresy nasluchu. NIGDY 0.0.0.0 - to wystawiloby pamiec na siec nadrzedna.
BIND_LOOPBACK=${DARKSTAR_CHROMA_BIND_LOOPBACK:-127.0.0.1}
BIND_PRIVATE=${DARKSTAR_CHROMA_BIND_PRIVATE:-192.168.2.1}
PORT=${DARKSTAR_CHROMA_PORT:-8000}

emit() {
    printf '%s=%s\n' "$1" "$2"
}

have() {
    command -v "$1" >/dev/null 2>&1
}

emit data_dir "$DATA_DIR"
emit bind_allowed "$BIND_LOOPBACK,$BIND_PRIVATE"
emit bind_forbidden '0.0.0.0,::'
emit port "$PORT"

if [ -d "$DATA_DIR" ]; then
    emit data_dir_present 'yes'
    emit data_dir_mode "$(stat -c '%a %U:%G' "$DATA_DIR" 2>/dev/null || printf 'unavailable')"
    emit data_dir_files "$(find "$DATA_DIR" -type f 2>/dev/null | wc -l | tr -d ' ')"
    emit data_dir_bytes "$(du -sb "$DATA_DIR" 2>/dev/null | cut -f1 || printf 'unavailable')"
else
    emit data_dir_present 'no'
    emit data_dir_mode 'unavailable:absent'
    emit data_dir_files 'unavailable:absent'
    emit data_dir_bytes 'unavailable:absent'
fi

# Chroma zyje we wlasnym venv, nie w systemowym Pythonie - szukamy jej najpierw tam.
VENV=${DARKSTAR_CHROMA_VENV:-/home/owner/darkstar/venv}
if [ -x "$VENV/bin/chroma" ]; then
    emit chroma_binary "venv:$VENV"
    emit chroma_version "$("$VENV/bin/python" -c 'import chromadb; print(chromadb.__version__)' 2>/dev/null || printf 'unavailable')"
elif have chroma; then
    emit chroma_binary 'system-path'
    emit chroma_version "$(python3 -c 'import chromadb; print(chromadb.__version__)' 2>/dev/null || printf 'unavailable')"
else
    emit chroma_binary 'absent'
    emit chroma_version 'unavailable:absent'
fi

if have ss; then
    if ss -ltn 2>/dev/null | grep -q ":$PORT "; then
        emit port_state 'listening'
    else
        emit port_state 'free'
    fi
else
    emit port_state 'unavailable:ss-missing'
fi

TENANT=${DARKSTAR_CHROMA_TENANT:-default_tenant}
DATABASE=${DARKSTAR_CHROMA_DATABASE:-default_database}

if have curl; then
    # chromadb 1.5.9 odpowiada na v2; starsze wydanie na E: mowi v1 i na v2 daje 404.
    # Sprawdzamy obie i zapisujemy, ktora odpowiedziala - to nie jest szczegol:
    # sciezka do kolekcji rozni sie miedzy wersjami.
    api=''
    for addr in "$BIND_LOOPBACK" "$BIND_PRIVATE"; do
        best='000'
        for v in v2 v1; do
            code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' \
                "http://$addr:$PORT/api/$v/heartbeat" 2>/dev/null) || true
            [ -n "$code" ] || code='000'
            if [ "$code" = 200 ]; then
                best=$code
                [ -n "$api" ] || api=$v
                break
            fi
            [ "$best" = '000' ] && best=$code
        done
        emit "heartbeat_$addr" "$best"
    done
    emit api_version "${api:-unavailable}"

    case ${api:-none} in
        v2) url="http://$BIND_LOOPBACK:$PORT/api/v2/tenants/$TENANT/databases/$DATABASE/collections?limit=10000" ;;
        v1) url="http://$BIND_LOOPBACK:$PORT/api/v1/collections" ;;
        *) url='' ;;
    esac

    if [ -n "$url" ]; then
        body=$(curl -s -m 15 "$url" 2>/dev/null || printf '')
        if [ -n "$body" ]; then
            # Pusta baza zwraca []. Liczymy wystapienia pola "name".
            emit collections "$(printf '%s' "$body" | grep -o '"name"' | wc -l | tr -d ' ')"
        else
            emit collections 'unavailable:no-response'
        fi
    else
        emit collections 'unavailable:no-api'
    fi
else
    emit heartbeat_loopback 'unavailable:curl-missing'
    emit api_version 'unavailable:curl-missing'
    emit collections 'unavailable:curl-missing'
fi

printf 'darkstar-chroma-health=read-only-complete\n'
